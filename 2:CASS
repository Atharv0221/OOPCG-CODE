B. KEYSPACE COMMANDS
--------------------

Create keyspace:
CREATE KEYSPACE collegeDB
WITH replication = {
    'class':'SimpleStrategy',
    'replication_factor':1
};

Show keyspaces:
DESCRIBE KEYSPACES;

Use keyspace:
USE collegeDB;

Describe current keyspace:
DESCRIBE KEYSPACE collegeDB;


C. CREATE TABLE
---------------

Create students table:
CREATE TABLE students (
    rollno INT PRIMARY KEY,
    name VARCHAR,
    dept VARCHAR,
    email VARCHAR,
    cgpa DOUBLE
);

Describe table:
DESCRIBE students;


