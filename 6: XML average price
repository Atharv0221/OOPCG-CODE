XQUERY 1: DISPLAY ALL BOOKS
---------------------------

xquery version "3.1";

for $book in /library/books/book
return $book


XQUERY 2: FIND AVERAGE PRICE AND DISPLAY BOOKS ABOVE AVERAGE
------------------------------------------------------------

xquery version "3.1";

let $books := /library/books/book

let $average-price :=
    avg(
        for $book in $books
        return xs:decimal($book/price)
    )

return
    <results>
        <average>{$average-price}</average>
        <above-average>
        {
            for $book in $books
            where xs:decimal($book/price) > $average-price
            return $book
        }
        </above-average>
    </results>


XQUERY 3: SORT BOOKS BY PUBLICATION YEAR
----------------------------------------

xquery version "3.1";

let $books := /library/books/book

for $book in $books
order by xs:integer($book/publish)
return $book


XQUERY 4: COMPLETE ASSIGNMENT 6 QUERY
-------------------------------------

xquery version "3.1";

let $books := /library/books/book

let $average-price :=
    avg(
        for $book in $books
        return xs:decimal($book/price)
    )

return
    <results>
        <average>{$average-price}</average>
        <above-average>
        {
            for $book in $books
            where xs:decimal($book/price) > $average-price
            order by xs:integer($book/publish)
            return $book
        }
        </above-average>
    </results>


